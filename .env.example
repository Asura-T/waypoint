# Copy to .env and adjust. .env is ignored by git.

# Host folder (TrueNAS dataset) that stores your maps. Must be writable by WAYPOINT_UID/GID.
WAYPOINT_DATA_PATH=/mnt/tank/apps/waypoint/data

# Port on the host that serves Waypoint (container always listens on 8080).
WAYPOINT_PORT=8080

# User/group the container runs as. 568 = TrueNAS "apps" user.
WAYPOINT_UID=568
WAYPOINT_GID=568

# Copy the fictional demo map into an empty data folder on first start.
WAYPOINT_SEED_DEMO=true

# Largest floor plan image you can upload, in MB.
WAYPOINT_MAX_UPLOAD_MB=40

TZ=UTC
